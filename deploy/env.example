# Copy to the server as /opt/poker/.env and fill in real values.
# Used by systemd EnvironmentFile (see deploy/poker-backend.service).

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL (local on ECS or Aliyun RDS)
DB_URL=jdbc:postgresql://127.0.0.1:5432/poker_db
DB_USERNAME=poker
DB_PASSWORD=change_me_to_a_strong_password
